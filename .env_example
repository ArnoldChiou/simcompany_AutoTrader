SESSIONID=your_session_id
USER_DATA_DIR=path_to_your_chrome_user_data(ex:C:\Users\YOUR_USER_NAME\AppData\Local\Google\Chrome\simauto2)
MIN_CASH_RESERVE=5000000
DEFAULT_MAX_TOTAL_COST=50000000
AUTOBUY_CYCLE_INTERVAL_SECONDS=600
AUTOBUY_PRODUCT_DELAY_MIN_SECONDS=8
AUTOBUY_PRODUCT_DELAY_MAX_SECONDS=15
AUTOBUY_RATE_LIMIT_BASE_DELAY_SECONDS=300
AUTOBUY_PRICE_HISTORY_SIZE=30
AUTOBUY_PRICE_HISTORY_MIN_SAMPLES=10
AUTOBUY_AVERAGE_DISCOUNT_PERCENTAGE=0.04

# Telegram construction and product-production completion notifications
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
# After a completion notification, idle/manual buildings are rechecked at this
# cadence until a new activity timer is found. Active buildings are scanned at
# their recorded finish time instead of on this hourly cadence.
ACTIVITY_MANUAL_RECHECK_SECONDS=3600
# Comma-separated product names to exclude from Telegram notifications (POWER is the default).
TELEGRAM_IGNORED_PRODUCTS=POWER
# Chrome profile logged in to the SimCompanies account whose Landscape is monitored
USER_DATA_DIR_construction_monitor=path_to_your_chrome_profile
# The VWAP-description updater defaults to the profile above; set this only to override it.
# SIMCOMPANIES_VWAP_PROFILE=path_to_your_signed_in_chrome_profile
# Give every Selenium service its own profile directory; never reuse this one
# for the Forest Nursery monitor.

# Retail-profit advisor for /b/54696865/.  It only changes unsaved form
# values, reads the 48-hour calculation, and never buys or starts production.
USER_DATA_DIR_retail_advisor=path_to_your_chrome_profile
RETAIL_ADVISOR_BUILDING_PATH=/b/54696865/
RETAIL_ADVISOR_HOURS=48
RETAIL_ADVISOR_REALM=0
